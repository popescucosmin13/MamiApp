{
  "name": "mamiapp",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "build": "npm run build:web",
    "build:web": "node scripts/copy-pwa-assets.js --public && node -e \"require('fs').rmSync('./dist',{recursive:true,force:true})\" && expo export --platform web && node scripts/copy-pwa-assets.js --dist",
    "android:preview": "npx eas-cli build --platform android --profile preview",
    "android:play": "npx eas-cli build --platform android --profile production",
    "android:submit": "npx eas-cli submit --platform android --profile production",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
